    // =========================================================================
    // Array-Based Priority Queue Logic (faithful to C implementation)
    // - Tasks are stored in an unsorted array in insertion order.
    // - New tasks are appended at the end.
    // - Finding the highest priority uses a linear search with strict '>'
    //   so equal priorities resolve in FIFO order (earlier inserted first).
    // - Processing removes the selected task from the pending queue (shifting
    //   subsequent items) and marks it Completed in the task history array.
    // =========================================================================

    const STORAGE_KEY = 'priorityflow_tasks_v1';

    const DEFAULT_TASKS = [
      { id: 'TSK-101', name: 'Audit API gateway rate-limit thresholds', priority: 3, status: 'Pending' },
      { id: 'TSK-102', name: 'Resolve production OAuth token timeout', priority: 5, status: 'Pending' },
      { id: 'TSK-103', name: 'Update weekly sprint changelog notes', priority: 1, status: 'Pending' },
      { id: 'TSK-104', name: 'Patch payment webhook retry backoff', priority: 5, status: 'Pending' },
      { id: 'TSK-105', name: 'Refactor PostgreSQL connection pooler', priority: 3, status: 'Pending' },
      { id: 'TSK-106', name: 'Migrate legacy static assets to CDN', priority: 1, status: 'Completed' },
      { id: 'TSK-107', name: 'Rotate staging TLS certificates', priority: 5, status: 'Completed' }
    ];

    let tasks = [];
    let currentView = 'dashboard';
    let searchQuery = '';
    let priorityFilter = 'all';
    let statusFilter = 'all';
    let sidebarCollapsed = false;
    let notifications = [
      { text: 'Queue initialized with 5 pending tasks', time: 'Just now' }
    ];

    function loadTasks() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed) && parsed.length > 0) {
            tasks = parsed;
            return;
          }
        }
      } catch (e) {
        // Fallback when localStorage is unavailable in sandboxed iframe
      }
      tasks = DEFAULT_TASKS.map(t => ({ ...t }));
    }

    function saveTasks() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(tasks));
      } catch (e) {
        // Ignore storage errors in opaque origin iframes
      }
    }

    function generateTaskId() {
      let maxNum = 100;
      for (let i = 0; i < tasks.length; i++) {
        const match = /^TSK-(\d+)$/.exec(tasks[i].id);
        if (match) {
          const n = parseInt(match[1], 10);
          if (n > maxNum) maxNum = n;
        }
      }
      return 'TSK-' + (maxNum + 1);
    }

    // Returns pending tasks in exact insertion order (never sorted)
    function getPendingQueue() {
      const pending = [];
      for (let i = 0; i < tasks.length; i++) {
        if (tasks[i].status === 'Pending') {
          pending.push(tasks[i]);
        }
      }
      return pending;
    }

    // Linear search for highest priority in pending queue (FIFO tie-break)
    function findHighestPriorityPending(pendingQueue) {
      if (pendingQueue.length === 0) return { task: null, index: -1 };
      let bestIdx = 0;
      let maxPriority = pendingQueue[0].priority;
      for (let i = 1; i < pendingQueue.length; i++) {
        if (pendingQueue[i].priority > maxPriority) {
          maxPriority = pendingQueue[i].priority;
          bestIdx = i;
        }
      }
      return { task: pendingQueue[bestIdx], index: bestIdx };
    }

    function getPriorityBadgeHTML(priority) {
      if (priority === 5) {
        return '<span data-component-id="badge-error" data-component-type="badge" data-component-variant="error" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-light-error-container text-light-on-error-container font-label text-label-sm"><span class="w-1.5 h-1.5 rounded-full bg-light-error"></span>High (5)</span>';
      }
      if (priority === 3) {
        return '<span data-component-id="badge-warning" data-component-type="badge" data-component-variant="warning" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-warning-container text-on-warning-container font-label text-label-sm"><span class="w-1.5 h-1.5 rounded-full bg-warning"></span>Medium (3)</span>';
      }
      return '<span data-component-id="badge-info" data-component-type="badge" data-component-variant="status" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-info-container text-on-info-container font-label text-label-sm"><span class="w-1.5 h-1.5 rounded-full bg-info"></span>Low (1)</span>';
    }

    function getStatusBadgeHTML(status) {
      if (status === 'Completed') {
        return '<span data-component-id="badge-success" data-component-type="badge" data-component-variant="success" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-success-container text-on-success-container font-label text-label-sm"><span class="w-1.5 h-1.5 rounded-full bg-success"></span>Completed</span>';
      }
      return '<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-light-surface-container text-light-primary font-label text-label-sm"><span class="w-1.5 h-1.5 rounded-full bg-light-primary"></span>Pending</span>';
    }

    function escapeHTML(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function renderStats() {
      const total = tasks.length;
      let pending = 0;
      let completed = 0;
      let highPending = 0;
      for (let i = 0; i < tasks.length; i++) {
        if (tasks[i].status === 'Pending') {
          pending++;
          if (tasks[i].priority === 5) highPending++;
        } else {
          completed++;
        }
      }
      document.getElementById('stat-total').textContent = total;
      document.getElementById('stat-pending').textContent = pending;
      document.getElementById('stat-completed').textContent = completed;
      document.getElementById('stat-high').textContent = highPending;

      const processBtn = document.getElementById('process-next-btn');
      processBtn.disabled = pending === 0;
    }

    function renderQueueVisualization() {
      const pendingQueue = getPendingQueue();
      const { task: nextTask } = findHighestPriorityPending(pendingQueue);
      const grid = document.getElementById('queue-cards-grid');
      const countPill = document.getElementById('queue-count-pill');

      countPill.textContent = pendingQueue.length + ' pending';

      if (pendingQueue.length === 0) {
        grid.innerHTML = '<div class="col-span-full py-8 text-center rounded-lg border border-dashed border-light-outline-variant bg-light-surface-container-low/50"><p class="font-title text-title-md text-light-on-surface">Queue is empty</p><p class="font-body text-body-sm text-light-on-surface-variant mt-1">Click Add New Task to append an item to the priority queue.</p></div>';
        return;
      }

      grid.innerHTML = pendingQueue.map((task, idx) => {
        const isNext = nextTask && task.id === nextTask.id;
        const borderClass = isNext
          ? 'border-light-secondary ring-1 ring-light-secondary/30 bg-light-surface-container-lowest'
          : 'border-light-outline-variant/60 bg-light-surface-container-lowest';
        const nextBadge = isNext
          ? '<span class="px-2 py-0.5 rounded-full bg-light-secondary text-light-on-secondary font-label text-label-sm">NEXT IN QUEUE</span>'
          : '<span class="font-mono text-mono-sm text-light-on-surface-variant">[' + idx + ']</span>';

        return (
          '<article data-component-id="card-interactive-2" data-component-type="card" data-component-variant="interactive" onclick="openPriorityModal(\'' + task.id + '\')" class="h-full rounded-lg border ' + borderClass + ' p-4 shadow-sm hover:shadow-md transition-shadow duration-state-change cursor-pointer flex flex-col justify-between gap-3">' +
            '<div class="flex items-center justify-between gap-2">' +
              '<span class="font-mono text-mono-sm text-light-on-surface-variant tabular-nums">' + escapeHTML(task.id) + '</span>' +
              nextBadge +
            '</div>' +
            '<p class="font-body text-body-md font-medium text-light-on-surface leading-snug">' + escapeHTML(task.name) + '</p>' +
            '<div class="flex items-center justify-between pt-2 border-t border-light-outline-variant/40">' +
              getPriorityBadgeHTML(task.priority) +
              '<span class="font-label text-label-sm text-light-primary">Update</span>' +
            '</div>' +
          '</article>'
        );
      }).join('');
    }

    function renderTable() {
      const tbody = document.getElementById('task-table-body');
      const summary = document.getElementById('table-summary');
      const q = searchQuery.trim().toLowerCase();

      const filtered = [];
      for (let i = 0; i < tasks.length; i++) {
        const t = tasks[i];
        if (currentView === 'pending' && t.status !== 'Pending') continue;
        if (currentView === 'completed' && t.status !== 'Completed') continue;
        if (statusFilter !== 'all' && t.status !== statusFilter) continue;
        if (priorityFilter !== 'all' && String(t.priority) !== priorityFilter) continue;
        if (q && !t.id.toLowerCase().includes(q) && !t.name.toLowerCase().includes(q)) continue;
        filtered.push(t);
      }

      summary.textContent = 'Showing ' + filtered.length + ' of ' + tasks.length + ' tasks';

      if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="px-5 py-10 text-center text-body-md text-light-on-surface-variant">No matching tasks found. Adjust your search or filters, or add a new task.</td></tr>';
        return;
      }

      tbody.innerHTML = filtered.map(task => {
        return (
          '<tr class="hover:bg-light-surface-container-low/60 transition-colors duration-state-change">' +
            '<td class="px-5 py-3.5 whitespace-nowrap"><span class="font-mono text-mono-md text-light-on-surface-variant tabular-nums">' + escapeHTML(task.id) + '</span></td>' +
            '<td class="px-5 py-3.5"><span class="font-body text-body-md font-medium text-light-on-surface">' + escapeHTML(task.name) + '</span></td>' +
            '<td class="px-5 py-3.5 whitespace-nowrap">' + getPriorityBadgeHTML(task.priority) + '</td>' +
            '<td class="px-5 py-3.5 whitespace-nowrap">' + getStatusBadgeHTML(task.status) + '</td>' +
            '<td class="px-5 py-3.5 whitespace-nowrap text-right">' +
              '<div class="inline-flex items-center justify-end gap-1">' +
                '<button type="button" onclick="openEditModal(\'' + task.id + '\')" title="Edit Task" aria-label="Edit ' + escapeHTML(task.id) + '" class="inline-flex items-center justify-center w-8 h-8 rounded text-light-on-surface-variant hover:bg-light-surface-container hover:text-light-primary transition-colors duration-state-change">' +
                  '<span class="material-symbols-outlined text-[18px]">edit</span>' +
                '</button>' +
                '<button type="button" onclick="openPriorityModal(\'' + task.id + '\')" title="Update Priority" aria-label="Update priority for ' + escapeHTML(task.id) + '" class="inline-flex items-center justify-center w-8 h-8 rounded text-light-on-surface-variant hover:bg-light-surface-container hover:text-light-secondary transition-colors duration-state-change">' +
                  '<span class="material-symbols-outlined text-[18px]">tune</span>' +
                '</button>' +
                '<button type="button" onclick="deleteTask(\'' + task.id + '\')" title="Delete Task" aria-label="Delete ' + escapeHTML(task.id) + '" class="inline-flex items-center justify-center w-8 h-8 rounded text-light-on-surface-variant hover:bg-light-error-container hover:text-light-error transition-colors duration-state-change">' +
                  '<span class="material-symbols-outlined text-[18px]">delete</span>' +
                '</button>' +
              '</div>' +
            '</td>' +
          '</tr>'
        );
      }).join('');
    }

    function renderAnalytics() {
      const total = tasks.length;
      let completed = 0;
      let pending = 0;
      let high = 0;
      let med = 0;
      let low = 0;

      for (let i = 0; i < tasks.length; i++) {
        if (tasks[i].status === 'Completed') completed++;
        else pending++;
        if (tasks[i].priority === 5) high++;
        else if (tasks[i].priority === 3) med++;
        else low++;
      }

      const compPct = total ? Math.round((completed / total) * 100) : 0;
      const pendPct = total ? 100 - compPct : 0;
      const circumference = 301.59;
      const offset = circumference - (compPct / 100) * circumference;

      document.getElementById('donut-completed-arc').setAttribute('stroke-dashoffset', offset.toFixed(2));
      document.getElementById('analytics-completion-pct').textContent = compPct + '%';
      document.getElementById('analytics-completed-count').textContent = completed + ' tasks';
      document.getElementById('analytics-pending-count').textContent = pending + ' tasks';
      document.getElementById('bar-completed').style.width = compPct + '%';
      document.getElementById('bar-pending').style.width = pendPct + '%';
      document.getElementById('analytics-total-tasks').textContent = total;

      const highPct = total ? Math.round((high / total) * 100) : 0;
      const medPct = total ? Math.round((med / total) * 100) : 0;
      const lowPct = total ? Math.round((low / total) * 100) : 0;

      document.getElementById('dist-high-label').textContent = high + ' (' + highPct + '%)';
      document.getElementById('dist-med-label').textContent = med + ' (' + medPct + '%)';
      document.getElementById('dist-low-label').textContent = low + ' (' + lowPct + '%)';
      document.getElementById('dist-high-bar').style.width = highPct + '%';
      document.getElementById('dist-med-bar').style.width = medPct + '%';
      document.getElementById('dist-low-bar').style.width = lowPct + '%';
    }

    function renderNotifications() {
      const list = document.getElementById('notif-list');
      const dot = document.getElementById('notif-dot');
      if (notifications.length === 0) {
        dot.classList.add('hidden');
        list.innerHTML = '<li class="font-body text-body-sm text-light-on-surface-variant py-2">No recent queue activity.</li>';
        return;
      }
      dot.classList.remove('hidden');
      list.innerHTML = notifications.slice(0, 6).map(n => (
        '<li class="pb-2 border-b border-light-outline-variant/40 last:border-b-0">' +
          '<p class="font-body text-body-sm text-light-on-surface">' + escapeHTML(n.text) + '</p>' +
          '<span class="font-mono text-mono-sm text-light-on-surface-variant">' + escapeHTML(n.time) + '</span>' +
        '</li>'
      )).join('');
    }

    function renderAll() {
      renderStats();
      renderQueueVisualization();
      renderTable();
      renderAnalytics();
      renderNotifications();
    }

    // View & Navigation Controls
    function switchView(view) {
      currentView = view;
      const titles = {
        dashboard: 'Dashboard',
        all: 'All Tasks',
        pending: 'Pending Tasks',
        completed: 'Completed Tasks',
        analytics: 'Analytics',
        settings: 'Settings'
      };
      document.getElementById('page-heading').textContent = titles[view] || 'Dashboard';

      document.querySelectorAll('.nav-item').forEach(btn => {
        const isActive = btn.getAttribute('data-nav') === view;
        btn.classList.toggle('bg-light-surface-container', isActive);
        btn.classList.toggle('text-light-primary', isActive);
        btn.classList.toggle('text-light-on-surface-variant', !isActive);
      });

      const statsEl = document.getElementById('stats-section');
      const queueEl = document.getElementById('queue-section');
      const tableEl = document.getElementById('table-section');
      const analyticsEl = document.getElementById('analytics-section');
      const settingsEl = document.getElementById('settings-section');
      const actionBar = document.getElementById('action-bar');

      statsEl.classList.toggle('hidden', view === 'analytics' || view === 'settings');
      queueEl.classList.toggle('hidden', view !== 'dashboard' && view !== 'pending');
      tableEl.classList.toggle('hidden', view === 'analytics' || view === 'settings');
      analyticsEl.classList.toggle('hidden', view !== 'dashboard' && view !== 'analytics');
      settingsEl.classList.toggle('hidden', view !== 'settings');
      actionBar.classList.toggle('hidden', view === 'settings');

      toggleMobileSidebar(false);
      renderTable();
    }

    function toggleSidebarCollapse() {
      sidebarCollapsed = !sidebarCollapsed;
      const sidebar = document.getElementById('sidebar');
      const brandText = document.getElementById('brand-text');
      const footer = document.getElementById('sidebar-footer');
      const icon = document.getElementById('collapse-icon');
      const labels = document.querySelectorAll('.nav-label');

      if (sidebarCollapsed) {
        sidebar.classList.replace('w-60', 'w-[72px]');
        brandText.classList.add('hidden');
        footer.classList.add('hidden');
        labels.forEach(l => l.classList.add('hidden'));
        icon.textContent = 'chevron_right';
      } else {
        sidebar.classList.replace('w-[72px]', 'w-60');
        brandText.classList.remove('hidden');
        footer.classList.remove('hidden');
        labels.forEach(l => l.classList.remove('hidden'));
        icon.textContent = 'menu_open';
      }
    }

    function toggleMobileSidebar(open) {
      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('mobile-sidebar-backdrop');
      if (open) {
        sidebar.classList.remove('-translate-x-full');
        backdrop.classList.remove('hidden');
      } else {
        sidebar.classList.add('-translate-x-full');
        backdrop.classList.add('hidden');
      }
    }

    function handleSearchInput(val) {
      searchQuery = val;
      document.getElementById('global-search-input').value = val;
      document.getElementById('table-search-input').value = val;
      renderTable();
    }

    function handlePriorityFilter(val) {
      priorityFilter = val;
      renderTable();
    }

    function handleStatusFilter(val) {
      statusFilter = val;
      renderTable();
    }

    // Modals & Actions
    function openAddModal() {
      document.getElementById('task-form-id').value = '';
      document.getElementById('task-modal-title').textContent = 'Add New Task';
      document.getElementById('task-modal-desc').textContent = 'Appends the task to the end of the pending queue array.';
      document.getElementById('task-form-submit-btn').querySelector('span').textContent = 'Add Task';
      document.getElementById('task-name-input').value = '';
      document.getElementById('task-priority-select').value = '3';
      document.getElementById('task-name-error').classList.add('hidden');
      document.getElementById('task-modal').showModal();
    }

    function openEditModal(taskId) {
      const task = tasks.find(t => t.id === taskId);
      if (!task) return;
      document.getElementById('task-form-id').value = task.id;
      document.getElementById('task-modal-title').textContent = 'Edit Task (' + task.id + ')';
      document.getElementById('task-modal-desc').textContent = 'Modify task name or priority while preserving array position.';
      document.getElementById('task-form-submit-btn').querySelector('span').textContent = 'Save Changes';
      document.getElementById('task-name-input').value = task.name;
      document.getElementById('task-priority-select').value = String(task.priority);
      document.getElementById('task-name-error').classList.add('hidden');
      document.getElementById('task-modal').showModal();
    }

    function handleTaskFormSubmit(e) {
      e.preventDefault();
      const id = document.getElementById('task-form-id').value;
      const nameInput = document.getElementById('task-name-input');
      const errorEl = document.getElementById('task-name-error');
      const name = nameInput.value.trim();
      const priority = parseInt(document.getElementById('task-priority-select').value, 10);

      if (!name) {
        errorEl.classList.remove('hidden');
        nameInput.focus();
        return;
      }
      errorEl.classList.add('hidden');

      if (id) {
        for (let i = 0; i < tasks.length; i++) {
          if (tasks[i].id === id) {
            tasks[i].name = name;
            tasks[i].priority = priority;
            break;
          }
        }
        addNotification('Updated task ' + id);
        showToast('Task ' + id + ' updated.');
      } else {
        const newId = generateTaskId();
        tasks.push({ id: newId, name: name, priority: priority, status: 'Pending' });
        addNotification('Inserted ' + newId + ' at end of queue');
        showToast('Added ' + newId + ' to queue.');
      }

      saveTasks();
      renderAll();
      closeModal('task-modal');
    }

    function openPriorityModal(taskId) {
      const task = tasks.find(t => t.id === taskId);
      if (!task) return;
      document.getElementById('priority-task-id').value = task.id;
      document.getElementById('priority-modal-task-id').textContent = task.id;
      document.getElementById('priority-modal-task-name').textContent = task.name;
      document.getElementById('priority-modal-current-badge').innerHTML = getPriorityBadgeHTML(task.priority);
      document.getElementById('new-priority-select').value = String(task.priority);
      document.getElementById('priority-modal').showModal();
    }

    function handlePrioritySubmit(e) {
      e.preventDefault();
      const taskId = document.getElementById('priority-task-id').value;
      const newPriority = parseInt(document.getElementById('new-priority-select').value, 10);

      for (let i = 0; i < tasks.length; i++) {
        if (tasks[i].id === taskId) {
          tasks[i].priority = newPriority;
          break;
        }
      }

      saveTasks();
      renderAll();
      closeModal('priority-modal');
      addNotification('Updated priority for ' + taskId + ' to ' + newPriority);
      showToast('Priority updated for ' + taskId + '.');
    }

    function openProcessModal() {
      const pendingQueue = getPendingQueue();
      const { task, index } = findHighestPriorityPending(pendingQueue);
      if (!task) {
        showToast('No pending tasks to process.');
        return;
      }
      document.getElementById('process-task-id').textContent = task.id;
      document.getElementById('process-task-name').textContent = task.name;
      document.getElementById('process-task-badge').innerHTML = getPriorityBadgeHTML(task.priority);
      document.getElementById('process-task-index').textContent = 'Pending array index [' + index + ']';
      document.getElementById('process-modal').showModal();
    }

    function confirmProcessNextTask() {
      const pendingQueue = getPendingQueue();
      const { task } = findHighestPriorityPending(pendingQueue);
      if (!task) {
        closeModal('process-modal');
        return;
      }

      for (let i = 0; i < tasks.length; i++) {
        if (tasks[i].id === task.id) {
          tasks[i].status = 'Completed';
          break;
        }
      }

      saveTasks();
      renderAll();
      closeModal('process-modal');
      addNotification('Processed ' + task.id + ' (' + task.name + ')');
      showToast('Processed ' + task.id + ' and removed from pending queue.');
    }

    function deleteTask(taskId) {
      const idx = tasks.findIndex(t => t.id === taskId);
      if (idx === -1) return;
      tasks.splice(idx, 1);
      saveTasks();
      renderAll();
      addNotification('Deleted task ' + taskId);
      showToast('Deleted ' + taskId + '.');
    }

    function resetSampleData() {
      tasks = DEFAULT_TASKS.map(t => ({ ...t }));
      saveTasks();
      renderAll();
      addNotification('Restored default sample task queue');
      showToast('Default sample tasks restored.');
    }

    function clearCompletedTasks() {
      tasks = tasks.filter(t => t.status === 'Pending');
      saveTasks();
      renderAll();
      addNotification('Cleared completed tasks');
      showToast('Completed tasks cleared.');
    }

    function closeModal(id) {
      document.getElementById(id).close();
    }

    function toggleNotifications() {
      document.getElementById('notif-popover').classList.toggle('hidden');
    }

    function clearNotifications() {
      notifications = [];
      renderNotifications();
    }

    function addNotification(text) {
      const now = new Date();
      const time = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      notifications.unshift({ text, time });
    }

    let toastTimer = null;
    function showToast(msg) {
      const container = document.getElementById('toast-container');
      document.getElementById('toast-message').textContent = msg;
      container.classList.remove('hidden');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        container.classList.add('hidden');
      }, 3000);
    }

    // Initialize on load
    loadTasks();
    renderAll();
  </script>


</body></html>