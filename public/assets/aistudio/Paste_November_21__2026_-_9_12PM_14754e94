              <p class="font-body text-label-sm text-light-on-surface-variant" data-design-text-token="label-sm">Systems Lead</p>
            </div>
          </div>
        </div>
      </header>

      <!-- Main Workspace -->
      <main class="flex-1 p-4 sm:p-6 max-w-[1440px] w-full mx-auto space-y-6">
