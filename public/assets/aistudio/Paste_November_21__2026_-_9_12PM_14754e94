          <button type="button" data-nav="completed" onclick="switchView(&#39;completed&#39;)" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded text-left transition-colors duration-state-change text-light-on-surface-variant hover:bg-light-surface-container-low hover:text-light-on-surface">
