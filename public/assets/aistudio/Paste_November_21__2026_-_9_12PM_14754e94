          </button>
          <button type="button" data-nav="all" onclick="switchView(&#39;all&#39;)" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded text-left transition-colors duration-state-change text-light-on-surface-variant hover:bg-light-surface-container-low hover:text-light-on-surface">
            <span class="material-symbols-outlined text-[20px] shrink-0">list_alt</span>
            <span class="nav-label font-label text-label-lg whitespace-nowrap" data-design-text-token="label-lg">All Tasks</span>
          </button>
          <button type="button" data-nav="pending" onclick="switchView(&#39;pending&#39;)" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded text-left transition-colors duration-state-change text-light-on-surface-variant hover:bg-light-surface-container-low hover:text-light-on-surface">
